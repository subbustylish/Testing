rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /testCases/{testCaseId} {
      allow read, write: if true;
    }

    match /importBatches/{batchId} {
      allow read, write: if true;
    }
  }
}
